Algoritmo "exercicio22"

Var
 n , numero1 , numero2:inteiro


Inicio
     escreva("digite n:")
     leia(n)
     escreva("digite numero1:")
     leia(numero1)
     escreva("digite numero2:")
     leia(numero2)
     n<- numero1 + numero2
     escreva("n é igual",n)
     




Fimalgoritmo