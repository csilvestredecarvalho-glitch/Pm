Algoritmo "EXERCICIO18"

Var
    salario , parcela:real


Inicio
escreva("salario:")
leia(salario)
escreva("parcela:")
leia(parcela)
se(parcela < salario * 0.30)entao
escreva("acesso permitido")
senao
se(parcela > salario * 0.30)entao
escreva("acesso negado")
fimse
fimse


Fimalgoritmo