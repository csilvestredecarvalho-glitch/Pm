Algoritmo "exercicio4"

Var
    base , altura , area:real


Inicio
        escreva(" escreva o valor da base de um retangulo: ")
        leia(base)
        escreva(" escreva o valor da altura de um retangulo: ")
        leia(altura)
        area<- base * altura
        escreva(" o valor da area e: " , area)

Fimalgoritmo