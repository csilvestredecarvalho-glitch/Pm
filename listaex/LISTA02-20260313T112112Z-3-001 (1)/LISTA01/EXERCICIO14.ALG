Algoritmo "ex14"


Var
    valor , desconto , compra , preco:real
Inicio
      escreva(" valor: ")
      leia(valor)
se(valor>100)entao
      desconto<- (valor * 10)
      preco<- (desconto /100)
      compra<- (valor - preco)
      escreva(" o valor da sua compra sera de: ",compra)

      fimse

      


Fimalgoritmo