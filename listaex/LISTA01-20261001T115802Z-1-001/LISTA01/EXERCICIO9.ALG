Algoritmo "exercicio9"




Var
     numero , dividir:real


Inicio
      escreva("digite o numero: ")
      leia(numero)
      dividir<- numero mod 2
      escreva(" o valor de sua divisao é" , dividir)
se (dividir=1)entao
      escreva(" este numero é impar ")
senao
      se (dividir=0)entao
      escreva(" este numero é par ")
      fimse
      fimse
Fimalgoritmo