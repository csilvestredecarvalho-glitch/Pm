Algoritmo "EXERCICIO17"

Var
   usuario:caracter
    senha:caracter


Inicio
      escreva("o usuario é:")
      leia(usuario)
      escreva(" a senha do usuario é:")
      leia(senha)
se(usuario= "admim ") e (senha= " 1234 ")entao
      escreva(" acesso permitido ")
senao
      escreva( "acesso negado")
      fimse


Fimalgoritmo