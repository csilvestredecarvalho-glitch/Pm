Algoritmo "exercicio3"

Var
     n1, antecessor , sucessor:inteiro








Inicio
       escreva("escreva o antecessor e sucessor deste numero:")
       leia(n1)
       sucessor<-n1+1
       antecessor<-n1-1
       
       escreva(" o antecessor e: ", antecessor)
       escreva(" o sucessor e: ", sucessor)








Fimalgoritmo