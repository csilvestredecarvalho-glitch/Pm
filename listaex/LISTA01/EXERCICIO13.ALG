Algoritmo "exercicio13"

Var
     n1:real


Inicio
     escreva(" numero: ")
     leia(n1)
se(n1>0)entao
escreva(" este numero é positivo ")
senao
se(n1<0)entao
escreva(" este número é negativo ")
senao
se(n1=0)entao
escreva(" este número é neutro ")
fimse
fimse
fimse



Fimalgoritmo