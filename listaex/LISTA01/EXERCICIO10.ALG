Algoritmo "exercicio10"

Var
   n1 , n2:real



Inicio
       escreva(" digite o n1: ")
       leia(n1)
       escreva(" digite o n2: " )
       leia(n2)
se     (n1 > n2)entao
       escreva("  n1 é maior que n2: ",n1)
senao
se     (n2 > n1)entao
        escreva(" n2 é maior que n1: ",n2)
        fimse
        fimse
       




Fimalgoritmo