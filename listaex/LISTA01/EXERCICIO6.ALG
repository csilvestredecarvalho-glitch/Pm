Algoritmo "exercicio6"

Var
     n1 , n2 , n3 , media:real
     


Inicio
     escreval(" escreva a n1: ")
     leia(n1)
     escreval(" escreva a n2: ")
     leia(n2)
     escreva(" escreva a n3: ")
     leia(n3)
     media<- (n1 + n2 + n3)/3
     escreval(" a sua media e: " , media)
